<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootBox"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.layla.ui.RankingController"
      spacing="15"
      alignment="TOP_CENTER"
      style="-fx-background-color: transparent;">

    <padding>
        <Insets top="20" right="40" bottom="20" left="40"/>
    </padding>

    <!-- Header -->
    <Label text="TOP 20 RUNS"
           styleClass="section-header ranking-title"
           style="-fx-font-size: 24px; -fx-text-fill: #ffd54f;"/>

    <!-- Table -->
    <TableView fx:id="rankingTable"
               VBox.vgrow="ALWAYS"
               styleClass="ranking-table"
               style="-fx-background-color: #222; -fx-border-color: #444; -fx-border-radius: 4;">

        <columns>
            <TableColumn fx:id="rankCol"
                         text="#"
                         prefWidth="50"
                         style="-fx-alignment: CENTER;"/>

            <TableColumn fx:id="nameCol"
                         text="PLAYER"
                         prefWidth="180"/>

            <TableColumn fx:id="scoreCol"
                         text="SCORE"
                         prefWidth="120"
                         style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold;"/>

            <TableColumn fx:id="floorCol"
                         text="FLOOR"
                         prefWidth="120"
                         style="-fx-alignment: CENTER;"/>

            <TableColumn fx:id="dateCol"
                         text="DATE"
                         prefWidth="200"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
