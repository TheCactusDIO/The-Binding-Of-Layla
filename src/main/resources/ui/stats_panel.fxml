<?xml version="1.0" encoding="UTF-8"?>


<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:controller="com.layla.ui.StatsPanelController"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           styleClass="stats-panel-root">

    <stylesheets>
        <URL value="@css/stats_panel.css"/>
    </stylesheets>

    <AnchorPane>
        <children>

            <ScrollPane fx:id="rootScroll"
                        fitToWidth="true"
                        pannable="true"
                        vbarPolicy="AS_NEEDED"
                        hbarPolicy="NEVER"
                        styleClass="transparent-scroll"
                        AnchorPane.topAnchor="20.0"
                        AnchorPane.leftAnchor="20.0"
                        AnchorPane.rightAnchor="20.0"
                        AnchorPane.bottomAnchor="20.0">

                <content>
                    <VBox spacing="14">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>

                        <children>
                            <Label text="Panel de estadisticas"
                                   styleClass="stats-panel-title"/>

                            <!-- PLAYER STATS -->
                            <GridPane hgap="10" vgap="8">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="40"/>
                                    <ColumnConstraints percentWidth="60"/>
                                </columnConstraints>

                                <children>
                                    <Label text="HP"
                                           GridPane.rowIndex="0" GridPane.columnIndex="0"
                                           styleClass="stats-label"/>
                                    <TextField fx:id="maxHpField"
                                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                    <Label text="Velocidad de movimiento (px/s)"
                                           GridPane.rowIndex="1" GridPane.columnIndex="0"
                                           styleClass="stats-label"/>
                                    <TextField fx:id="moveSpeedField"
                                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                    <Label text="Velocidad de disparo (shots/s)"
                                           GridPane.rowIndex="2" GridPane.columnIndex="0"
                                           styleClass="stats-label"/>
                                    <TextField fx:id="fireRateField"
                                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                    <Label text="Velocidad del proyectil (px/s)"
                                           GridPane.rowIndex="3" GridPane.columnIndex="0"
                                           styleClass="stats-label"/>
                                    <TextField fx:id="projSpeedField"
                                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                    <Label text="Rango del proyectil (s)"
                                           GridPane.rowIndex="4" GridPane.columnIndex="0"
                                           styleClass="stats-label"/>
                                    <TextField fx:id="projRangeField"
                                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                    <Label text="Daño del proyectil"
                                           GridPane.rowIndex="5" GridPane.columnIndex="0"
                                           styleClass="stats-label"/>
                                    <TextField fx:id="projDamageField"
                                               GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                    <!-- Coins row -->
                                    <HBox spacing="8.0"
                                          GridPane.rowIndex="6"
                                          GridPane.columnIndex="0"
                                          GridPane.columnSpan="2">
                                        <children>
                                            <Label text="Monedas:" styleClass="stats-label"/>
                                            <Spinner fx:id="coinsSpinner" prefWidth="100.0"/>
                                        </children>
                                    </HBox>
                                </children>
                            </GridPane>

                            <Separator/>

                            <!-- ENEMY PROFILES -->
                            <VBox spacing="10">
                                <children>
                                    <Label text="Perfiles de enemigos"
                                           styleClass="stats-section-title"/>

                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <children>
                                            <Label text="Tipo" styleClass="stats-label"/>
                                            <ComboBox fx:id="enemyTypeCombo" prefWidth="180"/>

                                            <CheckBox fx:id="stationaryCheck"
                                                      text="Estacionario"
                                                      styleClass="stats-checkbox"/>

                                            <Region HBox.hgrow="ALWAYS"/>

                                            <Button fx:id="saveBtn"
                                                    text="Guardar perfiles"
                                                    styleClass="menu-button"/>
                                        </children>
                                    </HBox>

                                    <GridPane hgap="10" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="40"/>
                                            <ColumnConstraints percentWidth="60"/>
                                        </columnConstraints>

                                        <children>
                                            <Label text="Vida Base" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="stats-label"/>
                                            <TextField fx:id="profileHpField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                            <Label text="Velocidad de movimiento (px/s)" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="stats-label"/>
                                            <TextField fx:id="profileSpeedField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                            <Label text="Daño por contacto" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="stats-label"/>
                                            <TextField fx:id="profileContactField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                            <Label text="Cadencia (disparos/s)" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="stats-label"/>
                                            <TextField fx:id="profileFireField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                            <Label text="Jitter (%)" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="stats-label"/>
                                            <TextField fx:id="profileJitterField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                            <Label text="Velocidad proyectil" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="stats-label"/>
                                            <TextField fx:id="profileProjSpeedField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                            <Label text="Alcance proyectil (px)" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="stats-label"/>
                                            <TextField fx:id="profileProjRangeField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                                            <Label text="Daño proyectil" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="stats-label"/>
                                            <TextField fx:id="profileProjDmgField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                                            <Label text="Puntuación" GridPane.rowIndex="8" GridPane.columnIndex="0" styleClass="stats-label"/>
                                            <TextField fx:id="profileScoreField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                                        </children>
                                    </GridPane>
                                </children>
                            </VBox>

                            <CheckBox fx:id="persistCheck"
                                      text="Persistir en JSON (usuario)"
                                      styleClass="stats-checkbox">
                                <tooltip>
                                    <Tooltip text="Si está activado, guarda los valores en ~/.layla/stats.json al pulsar Aplicar o Reset."/>
                                </tooltip>
                            </CheckBox>

                            <HBox spacing="10">
                                <children>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Cancelar" onAction="#onCancel" styleClass="menu-button">
                                        <tooltip><Tooltip text="Cerrar sin aplicar cambios."/></tooltip>
                                    </Button>
                                    <Button text="Reset" onAction="#onReset" styleClass="menu-button">
                                        <tooltip><Tooltip text="Restaurar valores por defecto y aplicarlos al instante."/></tooltip>
                                    </Button>
                                    <Button text="Aplicar" onAction="#onApply" styleClass="menu-button">
                                        <tooltip><Tooltip text="Guardar y aplicar los valores introducidos."/></tooltip>
                                    </Button>
                                </children>
                            </HBox>

                        </children>
                    </VBox>
                </content>
            </ScrollPane>

        </children>
    </AnchorPane>
</StackPane>
