<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Issue 6 – Overlay de Pausa
  Raíz TRANSPARENTE: el oscurecido lo aporta OverlayRouter (como Settings).
  El panel central tiene fondo suave para legibilidad.
-->
<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.layla.ui.PauseOverlayController"
           style="-fx-background-color: transparent;">

    <!-- Panel central -->
    <VBox fx:id="contentBox"
          alignment="CENTER"
          spacing="16"
          StackPane.alignment="CENTER"
          styleClass="pause-panel">

        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>

        <!-- Título con la misma clase que usas en el menú -->
        <Label text="Paused" styleClass="menu-title"/>

        <!-- Botones con ancho fijo agradable y misma clase visual del menú -->
        <Button text="Resume"      onAction="#onResume"     styleClass="menu-button" prefWidth="240"/>
        <Button text="Settings"     onAction="#onSettings"   styleClass="menu-button" prefWidth="240"/>
        <Button text="Back to Menu" onAction="#onBackToMenu" styleClass="menu-button" prefWidth="240"/>
    </VBox>
</StackPane>
