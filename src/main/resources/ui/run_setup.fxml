<?xml version="1.0" encoding="UTF-8"?>


<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.layla.ui.RunSetupController"
           styleClass="run-setup-root">

    <stylesheets>
        <URL value="@css/run_setup.css"/>
    </stylesheets>

    <VBox spacing="25" alignment="CENTER">

        <Label text="NUEVA PARTIDA"
               styleClass="run-title"/>

        <Label text="SELECCIONA PERSONAJE"
               styleClass="run-subtitle"/>

        <HBox spacing="40" alignment="CENTER">

            <!-- LAYLA -->
            <VBox fx:id="charBoxLayla"
                  spacing="12" alignment="TOP_CENTER"
                  prefWidth="220" prefHeight="260"
                  onMouseClicked="#onSelectLayla"
                  styleClass="character-card">
                <padding>
                    <Insets top="25" right="20" bottom="25" left="20"/>
                </padding>

                <Label text="LAYLA"
                       styleClass="character-name character-name-layla"/>
                <Separator styleClass="soft-separator"/>
                <Label text="Estadísticas equilibradas."
                       wrapText="true" textAlignment="CENTER"
                       styleClass="character-description"/>
                <Label text="VIDA: 3 corazones"
                       styleClass="character-hp"/>
            </VBox>

            <!-- THE FRAGILE -->
            <VBox fx:id="charBoxFragile"
                  spacing="12" alignment="TOP_CENTER"
                  prefWidth="220" prefHeight="260"
                  onMouseClicked="#onSelectFragile"
                  styleClass="character-card">
                <padding>
                    <Insets top="25" right="20" bottom="25" left="20"/>
                </padding>

                <Label text="THE FRAGILE"
                       styleClass="character-name character-name-fragile"/>
                <Separator styleClass="soft-separator"/>
                <Label text="Mucho daño, muy poca vida."
                       wrapText="true" textAlignment="CENTER"
                       styleClass="character-description"/>
                <Label text="VIDA: 1 corazón"
                       styleClass="character-hp"/>

                <!-- Se muestra sólo si está bloqueado -->
                <Label fx:id="fragileLockLabel"
                       text="BLOQUEADO"
                       wrapText="true" textAlignment="CENTER"
                       styleClass="character-lock"/>
            </VBox>
        </HBox>

        <CheckBox fx:id="hardModeCheck"
                  text="Modo difícil"
                  styleClass="run-checkbox"/>

        <HBox spacing="20" alignment="CENTER" styleClass="run-actions">

            <Button text="VOLVER"
                    onAction="#onBack"
                    styleClass="menu-button, btn-back, btn, btn-secondary"
                    prefWidth="140"/>

            <Button text="MODO PERSONALIZADO"
                    onAction="#onCustomMode"
                    styleClass="menu-button, btn, btn-secondary, btn-accent"/>

            <Button fx:id="playButton"
                    text="EMPEZAR"
                    onAction="#onPlay"
                    styleClass="menu-button, btn-success, btn, btn-primary, btn-large"
                    prefWidth="200"/>
        </HBox>

    </VBox>
</StackPane>



