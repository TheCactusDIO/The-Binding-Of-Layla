<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.layla.ui.CollectionController"
           style="-fx-background-color: #0d0d0d;">

    <VBox spacing="0" alignment="TOP_CENTER" maxWidth="1280" maxHeight="720">

        <HBox alignment="CENTER_LEFT" style="-fx-padding: 20; -fx-background-color: #111; -fx-border-color: #333; -fx-border-width: 0 0 2 0;">
            <Button text="&lt; BACK" onAction="#onBack" styleClass="menu-button"
                    style="-fx-font-size: 14px; -fx-padding: 8 20;"/>

            <Label text="COLLECTION" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER"
                   style="-fx-text-fill: white; -fx-font-family: 'Upheaval TT (BRK)'; -fx-font-size: 32px;"/>
             <Label text="       " style="-fx-min-width: 80;"/>
        </HBox>

        <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: transparent;">
             <stylesheets>
                <java.net.URL value="@styles/global.css"/>
             </stylesheets>
             <style>
                .tab-header-area .tab-header-background { -fx-background-color: transparent; }
                .tab { -fx-background-color: #222; -fx-text-fill: white; -fx-pref-width: 200; -fx-pref-height: 40; -fx-font-size: 16px; -fx-font-family: 'Upheaval TT (BRK)'; }
                .tab:selected { -fx-background-color: #444; -fx-border-color: #ffd54f; -fx-border-width: 0 0 3 0; }
                .tab-label { -fx-text-fill: white; }
             </style>

            <tabs>
                <Tab fx:id="tabBestiary" text="BESTIARY" />
                <Tab fx:id="tabItems" text="ITEMS" />
                <Tab fx:id="tabAchievements" text="ACHIEVEMENTS" />
            </tabs>
        </TabPane>

    </VBox>
</StackPane>
