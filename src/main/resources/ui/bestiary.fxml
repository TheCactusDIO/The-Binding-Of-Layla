<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.layla.ui.BestiaryController"
           style="-fx-background-color: transparent;">

    <VBox spacing="0" alignment="TOP_CENTER" maxWidth="1000" maxHeight="650">

        <HBox spacing="20" VBox.vgrow="ALWAYS" style="-fx-padding: 20;">

            <!-- LISTA -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="list-panel">
                <Label text="ENCOUNTERS" styleClass="section-header"/>

                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background: transparent;"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="gridPane"
                                  hgap="12" vgap="12"
                                  alignment="TOP_LEFT"
                                  style="-fx-background-color: transparent;"/>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- DETALLES (COLAPSABLE) -->
            <VBox fx:id="detailsPanel"
                  spacing="15"
                  alignment="TOP_CENTER"
                  prefWidth="0"
                  minWidth="0"
                  maxWidth="380"
                  visible="false"
                  managed="false"
                  opacity="0.0"
                  styleClass="detail-panel">

                <StackPane styleClass="icon-box-large">
                    <ImageView fx:id="detailImage" fitWidth="120" fitHeight="120" preserveRatio="true"/>
                </StackPane>

                <Label fx:id="detailName"
                       text="SELECT AN ENEMY"
                       wrapText="true"
                       textAlignment="CENTER"
                       style="-fx-text-fill: #ffd54f; -fx-font-family: 'Upheaval TT (BRK)'; -fx-font-size: 28px;"/>

                <Separator style="-fx-opacity: 0.3;"/>

                <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="280">
                    <HBox>
                        <Label text="ENCOUNTERS:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="statSeen" text="0" style="-fx-text-fill: white;"/>
                    </HBox>
                    <HBox>
                        <Label text="KILLS:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="statKills" text="0" style="-fx-text-fill: white;"/>
                    </HBox>
                    <HBox>
                        <Label text="DEATHS BY:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="statDeaths" text="0" style="-fx-text-fill: #ff5555;"/>
                    </HBox>
                </VBox>

                <Separator style="-fx-opacity: 0.3;"/>

                <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="280">
                    <HBox>
                        <Label text="BASE HP:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="attrHp" text="-" style="-fx-text-fill: #ffd54f;"/>
                    </HBox>
                    <HBox>
                        <Label text="CONTACT DMG:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="attrDmg" text="-" style="-fx-text-fill: #ffd54f;"/>
                    </HBox>
                    <HBox>
                        <Label text="PROJ DMG:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="attrProjDmg" text="-" style="-fx-text-fill: #ffd54f;"/>
                    </HBox>
                    <HBox>
                        <Label text="SPEED:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="attrSpeed" text="-" style="-fx-text-fill: #ffd54f;"/>
                    </HBox>
                </VBox>

                <Button text="CLOSE"
                        onAction="#onCloseDetails"
                        styleClass="menu-button"
                        style="-fx-padding: 8 20;"/>

            </VBox>

        </HBox>
    </VBox>

</StackPane>
