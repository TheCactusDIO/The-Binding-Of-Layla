<?xml version="1.0" encoding="UTF-8"?>


<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!--
  Root TRANSPARENTE: el oscurecido lo aporta OverlayRouter.
  El panel central tiene fondo para legibilidad.
-->
<StackPane fx:id="root"
           fx:controller="com.layla.ui.GameOverController"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           styleClass="overlay-root">

    <stylesheets>
        <URL value="@css/game_over.css"/>
    </stylesheets>

    <StackPane.alignment>CENTER</StackPane.alignment>

    <VBox spacing="16"
          alignment="CENTER"
          styleClass="overlay-panel">

        <Text fx:id="titleText"
              text="FIN DE LA PARTIDA"
              styleClass="overlay-title" />

        <Label text="Pulsa ENTER para reintentar o ESC para volver al menú"
               styleClass="overlay-hint" />

        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="retryButton"
                    text="Reintentar"
                    onAction="#onRetry"
                    styleClass="btn btn-primary" />

            <Button fx:id="menuButton"
                    text="Menú"
                    onAction="#onMenu"
                    styleClass="btn btn-secondary" />
        </HBox>
    </VBox>

</StackPane>




