<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!--
  Root TRANSPARENTE: el oscurecido lo aporta OverlayRouter.
  El panel central tiene fondo para legibilidad.
-->
<StackPane fx:id="root"
           fx:controller="com.layla.ui.GameOverController"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           style="-fx-background-color: transparent;">

    <StackPane.alignment>CENTER</StackPane.alignment>

    <VBox spacing="16"
          alignment="CENTER"
          style="-fx-background-color: #1b1b1b; -fx-background-radius: 12; -fx-padding: 28;">

        <Text fx:id="titleText"
              text="FIN DE LA PARTIDA"
              style="-fx-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" />

        <Label text="Pulsa ENTER para reintentar o ESC para volver al menú"
               style="-fx-text-fill: #bbbbbb; -fx-font-size: 13px;" />

        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="retryButton"
                    text="Reintentar"
                    onAction="#onRetry"
                    style="-fx-font-size: 14px; -fx-padding: 8 18; -fx-background-radius: 8;" />

            <Button fx:id="menuButton"
                    text="Menú"
                    onAction="#onMenu"
                    style="-fx-font-size: 14px; -fx-padding: 8 18; -fx-background-radius: 8;" />
        </HBox>
    </VBox>

</StackPane>
