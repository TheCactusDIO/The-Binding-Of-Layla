<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.media.MediaView?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.layla.ui.MainMenuController"
           prefWidth="1280" prefHeight="720"
           id="main-menu-root">

    <children>
        <MediaView fx:id="backgroundVideo" StackPane.alignment="CENTER"/>

        <VBox fx:id="menuBox"
              StackPane.alignment="CENTER"
              spacing="18"
              fillWidth="false"
              styleClass="menu-container">

            <children>
                <Label fx:id="titleLabel"
                       text="The Binding of Layla"
                       wrapText="true"
                       styleClass="menu-title" />

                <Button fx:id="playBtn"
                        text="Play"
                        onAction="#onPlayClicked"
                        styleClass="menu-button"/>

                <Button fx:id="profilesBtn"
                        text="Profiles"
                        onAction="#onProfilesClicked"
                        styleClass="menu-button"/>

                <Button fx:id="collectionBtn"
                        text="Collection"
                        onAction="#onCollectionClicked"
                        styleClass="menu-button"/>

                <Button fx:id="optionsBtn"
                        text="Options"
                        onAction="#onOptionsClicked"
                        styleClass="menu-button"/>

                <Button fx:id="exitBtn"
                        text="Exit"
                        onAction="#onExitClicked"
                        styleClass="menu-button"/>
            </children>
        </VBox>
    </children>
</StackPane>
