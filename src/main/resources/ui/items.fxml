<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.layla.ui.ItemsController"
      styleClass="items-content">

    <stylesheets>
        <URL value="@css/items.css"/>
    </stylesheets>

    <!-- LISTA / GRID -->
    <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="list-panel">
        <Label text="OBJETOS DESBLOQUEADOS" styleClass="section-header"/>

        <ScrollPane fitToWidth="true"
                    styleClass="transparent-scroll"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="gridPane"
                          hgap="12" vgap="12"
                          alignment="TOP_LEFT"
                          styleClass="transparent-pane"/>
            </content>
        </ScrollPane>
    </VBox>

    <!-- DETALLES -->
    <VBox fx:id="detailsPanel"
          spacing="15"
          alignment="TOP_CENTER"
          prefWidth="320" minWidth="320"
          styleClass="detail-panel"
          visible="false"
          managed="false">

        <StackPane styleClass="icon-box-large">
            <ImageView fx:id="detailImage"
                       fitWidth="80" fitHeight="80"
                       preserveRatio="true"/>
        </StackPane>

        <Label fx:id="detailName"
               text="NOMBRE DEL OBJETO"
               wrapText="true"
               textAlignment="CENTER"
               styleClass="item-detail-title"/>

        <Label fx:id="detailPool"
               text="ORIGEN"
               styleClass="item-detail-pool"/>

        <Separator styleClass="soft-separator"/>

        <Label text="EFECTOS" styleClass="section-header"/>
        <Label fx:id="detailDescription"
               text="..."
               wrapText="true"
               styleClass="item-detail-desc"/>

        <Separator styleClass="soft-separator"/>

        <Label text="ESTADÍSTICAS" styleClass="section-header"/>
        <Label fx:id="detailStats"
               text="..."
               wrapText="true"
               styleClass="item-detail-stats"/>

    </VBox>
</HBox>
