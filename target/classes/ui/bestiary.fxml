<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.layla.ui.BestiaryController"
           style="-fx-background-color: #111111;">

    <VBox spacing="0" alignment="TOP_CENTER" maxWidth="1000" maxHeight="650">

        <HBox alignment="CENTER_LEFT" style="-fx-padding: 20;">
            <Button text="&lt; BACK" onAction="#onBack" styleClass="menu-button"
                    style="-fx-font-size: 14px; -fx-padding: 8 20;"/>
            <Label text="BESTIARY" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER"
                   style="-fx-text-fill: white; -fx-font-family: 'Upheaval TT (BRK)'; -fx-font-size: 42px;
                          -fx-effect: dropshadow(gaussian, black, 4, 0.5, 0, 0);"/>
            <Label text="       " style="-fx-font-size: 14px;"/>
        </HBox>

        <HBox spacing="20" VBox.vgrow="ALWAYS" style="-fx-padding: 0 40 40 40;">

            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: #222; -fx-background-radius: 12; -fx-border-color: #444; -fx-border-width: 2; -fx-border-radius: 12;">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                <Label text="ENCOUNTERS" style="-fx-text-fill: #888; -fx-font-weight: bold;"/>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="gridPane" hgap="12" vgap="12" alignment="TOP_LEFT"
                                  style="-fx-background-color: transparent;"/>
                    </content>
                </ScrollPane>
            </VBox>

            <VBox fx:id="detailsPanel" spacing="15" alignment="TOP_CENTER" prefWidth="380" minWidth="380"
                  style="-fx-background-color: #1a1a1a; -fx-background-radius: 12; -fx-border-color: #555; -fx-border-width: 2; -fx-border-radius: 12;">
                <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

                <StackPane style="-fx-background-color: #111; -fx-background-radius: 8; -fx-padding: 20;">
                    <ImageView fx:id="detailImage" fitWidth="120" fitHeight="120" preserveRatio="true"/>
                </StackPane>

                <Label fx:id="detailName" text="SELECT AN ENEMY" wrapText="true" textAlignment="CENTER"
                       style="-fx-text-fill: #ffd54f; -fx-font-family: 'Upheaval TT (BRK)'; -fx-font-size: 28px;"/>

                <Separator style="-fx-opacity: 0.3;"/>

                <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="280">
                    <HBox>
                        <Label text="ENCOUNTERS:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="statSeen" text="0" style="-fx-text-fill: white;"/>
                    </HBox>
                    <HBox>
                        <Label text="KILLS:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="statKills" text="0" style="-fx-text-fill: white;"/>
                    </HBox>
                    <HBox>
                        <Label text="DEATHS BY:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="statDeaths" text="0" style="-fx-text-fill: #ff5555;"/>
                    </HBox>
                </VBox>

                <Separator style="-fx-opacity: 0.3;"/>

                <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="280">
                    <HBox>
                        <Label text="BASE HP:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="attrHp" text="-" style="-fx-text-fill: #ffd54f;"/>
                    </HBox>
                    <HBox>
                        <Label text="CONTACT DMG:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="attrDmg" text="-" style="-fx-text-fill: #ffd54f;"/>
                    </HBox>
                    <HBox>
                        <Label text="PROJ DMG:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="attrProjDmg" text="-" style="-fx-text-fill: #ffd54f;"/>
                    </HBox>
                    <HBox>
                        <Label text="SPEED:" style="-fx-text-fill: #aaa; -fx-font-weight: bold; -fx-min-width: 140;"/>
                        <Label fx:id="attrSpeed" text="-" style="-fx-text-fill: #ffd54f;"/>
                    </HBox>
                </VBox>

            </VBox>
        </HBox>
    </VBox>
</StackPane>
