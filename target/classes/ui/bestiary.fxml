<?xml version="1.0" encoding="UTF-8"?>


<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.layla.ui.BestiaryController"
           styleClass="bestiary-root">

    <stylesheets>
        <URL value="@css/bestiary.css"/>
    </stylesheets>

    <VBox spacing="0" alignment="TOP_CENTER" maxWidth="1000" maxHeight="650">

        <HBox spacing="20" VBox.vgrow="ALWAYS" styleClass="bestiary-content">

            <!-- LISTA -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="list-panel">
                <Label text="ENCUENTROS" styleClass="section-header"/>

                <ScrollPane fitToWidth="true"
                            styleClass="transparent-scroll"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="gridPane"
                                  hgap="12" vgap="12"
                                  alignment="TOP_LEFT"
                                  styleClass="transparent-pane"/>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- DETALLES (COLAPSABLE) -->
            <VBox fx:id="detailsPanel"
                  spacing="15"
                  alignment="TOP_CENTER"
                  prefWidth="0"
                  minWidth="0"
                  maxWidth="380"
                  visible="false"
                  managed="false"
                  opacity="0.0"
                  styleClass="detail-panel">

                <StackPane styleClass="icon-box-large">
                    <ImageView fx:id="detailImage" fitWidth="120" fitHeight="120" preserveRatio="true"/>
                </StackPane>

                <Label fx:id="detailName"
                       text="SELECCIONA UN ENEMIGO"
                       wrapText="true"
                       textAlignment="CENTER"
                       styleClass="detail-title"/>

                <Separator styleClass="soft-separator"/>

                <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="280">
                    <HBox>
                        <Label text="ENCUENTROS:" styleClass="stat-label"/>
                        <Label fx:id="statSeen" text="0" styleClass="stat-value"/>
                    </HBox>
                    <HBox>
                        <Label text="MATADOS:" styleClass="stat-label"/>
                        <Label fx:id="statKills" text="0" styleClass="stat-value"/>
                    </HBox>
                    <HBox>
                        <Label text="MUERTO POR:" styleClass="stat-label"/>
                        <Label fx:id="statDeaths" text="0" styleClass="stat-value-danger"/>
                    </HBox>
                </VBox>

                <Separator styleClass="soft-separator"/>

                <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="280">
                    <HBox>
                        <Label text="VIDA BASE:" styleClass="stat-label"/>
                        <Label fx:id="attrHp" text="-" styleClass="stat-value-gold"/>
                    </HBox>
                    <HBox>
                        <Label text="DAÑO POR CONTACTO:" styleClass="stat-label"/>
                        <Label fx:id="attrDmg" text="-" styleClass="stat-value-gold"/>
                    </HBox>
                    <HBox>
                        <Label text="DAÑO POR PROYECTIL:" styleClass="stat-label"/>
                        <Label fx:id="attrProjDmg" text="-" styleClass="stat-value-gold"/>
                    </HBox>
                    <HBox>
                        <Label text="VELOCIDAD:" styleClass="stat-label"/>
                        <Label fx:id="attrSpeed" text="-" styleClass="stat-value-gold"/>
                    </HBox>
                </VBox>

                <Button text="CERRAR"
                        onAction="#onCloseDetails"
                        styleClass="menu-button bestiary-close-button"/>

            </VBox>

        </HBox>
    </VBox>

</StackPane>
