<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Raíz transparente: el oscurecido lo aporta OverlayRouter.
  El panel central usa styleClass="pause-panel" para legibilidad.
-->
<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.layla.ui.PauseOverlayController"
           styleClass="pause-overlay-root">

    <!-- Panel central -->
    <VBox fx:id="contentBox"
          alignment="CENTER"
          spacing="16"
          StackPane.alignment="CENTER"
          styleClass="pause-panel">

        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>

        <!-- Título reutilizando clase visual del menú -->
        <Label text="Pausa" styleClass="menu-title"/>

        <!-- Botones reutilizando la clase del menú -->
        <Button text="Reanudar"      onAction="#onResume"     styleClass="menu-button" prefWidth="240" defaultButton="true"/>
        <Button text="Opciones"      onAction="#onSettings"   styleClass="menu-button" prefWidth="240"/>
        <Button text="Volver al menú" onAction="#onBackToMenu" styleClass="menu-button" prefWidth="240"/>
    </VBox>
</StackPane>
