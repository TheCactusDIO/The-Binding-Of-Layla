<?xml version="1.0" encoding="UTF-8"?>


<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.layla.ui.ShopOverlayController"
           fx:id="root"
           styleClass="shop-overlay-root">

    <stylesheets>
        <URL value="@css/shop_overlay.css"/>
    </stylesheets>

    <children>
        <!-- Transparente: el oscurecido lo hace OverlayRouter -->
        <AnchorPane styleClass="overlay-root">
            <children>
                <HBox alignment="CENTER" spacing="20"
                      AnchorPane.topAnchor="40.0" AnchorPane.bottomAnchor="40.0"
                      AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0">

                    <!-- Panel TIENDA -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="600"
                          styleClass="shop-panel">

                        <Label text="TIENDA"
                               styleClass="shop-title"/>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="coinsLabel" text="Monedas: 0¢"
                                   styleClass="shop-coins"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="rerollButton" text="Rebarajar (1¢)"
                                    styleClass="menu-button btn btn-secondary btn-compact"
                                    onAction="#onReroll"/>
                        </HBox>

                        <Separator styleClass="soft-separator"/>

                        <ScrollPane fitToWidth="true"
                                    styleClass="transparent-scroll"
                                    VBox.vgrow="ALWAYS"
                                    hbarPolicy="NEVER">
                            <content>
                                <VBox fx:id="offersContainer" spacing="8.0"/>
                            </content>
                        </ScrollPane>

                        <Button fx:id="continueButton" text="SALIR DE LA TIENDA"
                                styleClass="menu-button, btn-success"
                                onAction="#onClose"
                                maxWidth="Infinity"
                                cancelButton="true"/>
                    </VBox>

                    <!-- Panel STATS -->
                    <VBox spacing="8" minWidth="280" maxWidth="320"
                          styleClass="shop-panel shop-panel-shadow">

                        <Label text="ESTADÍSTICAS"
                               styleClass="stats-title"/>
                        <Separator styleClass="soft-separator"/>

                        <ScrollPane fitToWidth="true"
                                    styleClass="transparent-scroll"
                                    VBox.vgrow="ALWAYS"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED">
                            <content>
                                <VBox fx:id="statsContainer" spacing="4"
                                      styleClass="stats-container"/>
                            </content>
                        </ScrollPane>
                    </VBox>

                </HBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>




