<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<VBox fx:id="menuBox"
      spacing="18"
      alignment="CENTER"
      fillWidth="false"
      prefWidth="600"
      prefHeight="300">
    <Label fx:id="messageLabel" text="An error occurred while loading assets." wrapText="true" />
    <Button text="Exit" onAction="#onExit" />
</VBox>
