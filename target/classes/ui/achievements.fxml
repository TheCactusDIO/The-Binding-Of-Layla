<?xml version="1.0" encoding="UTF-8"?>


<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.layla.ui.AchievementsController"
           styleClass="achievements-root">

    <stylesheets>
        <URL value="@css/achievements.css"/>
    </stylesheets>

    <VBox spacing="12" alignment="TOP_CENTER" maxWidth="1000" maxHeight="650"
          styleClass="achievements-container">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Button text="VOLVER" onAction="#onBack"
                    styleClass="menu-button achievements-back-button"/>

            <Label text="LOGROS"
                   styleClass="achievements-title"/>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox fx:id="mainContentBox" spacing="20" VBox.vgrow="ALWAYS">

            <!-- Lista -->
            <ScrollPane fx:id="scrollPane" HBox.hgrow="ALWAYS" fitToWidth="true"
                        styleClass="transparent-scroll"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <StackPane>
                        <VBox fx:id="achievementListContainer" spacing="10" styleClass="list-panel"/>
                    </StackPane>
                </content>
            </ScrollPane>

            <!-- Panel detalle (arranca cerrado) -->
            <VBox fx:id="detailPanel"
                  spacing="15"
                  alignment="TOP_CENTER"
                  prefWidth="0"
                  minWidth="0"
                  maxWidth="380"
                  styleClass="detail-panel">

                <StackPane styleClass="icon-box-large">
                    <ImageView fx:id="detailImage" fitWidth="120" fitHeight="120" preserveRatio="true"/>
                </StackPane>

                <Label fx:id="detailName" text="NOMBRE DEL LOGRO" wrapText="true" textAlignment="CENTER"
                       styleClass="detail-title"/>

                <Label fx:id="detailStatus" text="BLOQUEADO"
                       styleClass="detail-status"/>

                <Separator styleClass="soft-separator"/>

                <VBox spacing="5" alignment="CENTER_LEFT" maxWidth="300">
                    <Label text="Condición:" styleClass="section-header"/>
                    <Label fx:id="detailDescription" text="..." wrapText="true" styleClass="detail-description"/>
                </VBox>

                <Separator styleClass="soft-separator"/>

                <VBox spacing="5" alignment="CENTER_LEFT" maxWidth="300">
                    <Label text="Recompensa:" styleClass="section-header"/>
                    <Label fx:id="detailUnlockContent" text="..." wrapText="true" styleClass="detail-unlock"/>
                </VBox>

                <Button text="CERRAR DETALLES" onAction="#onCloseDetails"
                        styleClass="menu-button detail-close-button"/>
            </VBox>

        </HBox>
    </VBox>
</StackPane>


