<?xml version="1.0" encoding="UTF-8"?>


<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Root TRANSPARENTE: el oscurecido lo aporta OverlayRouter.
  El panel central tiene fondo suave para legibilidad.
-->
<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.layla.ui.ItemPickupOverlayController"
           styleClass="overlay-root">

    <stylesheets>
        <URL value="@css/item_pickup_overlay.css"/>
    </stylesheets>

    <children>
        <VBox spacing="12"
              alignment="CENTER"
              styleClass="overlay-panel"
              StackPane.alignment="CENTER">

            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <!-- Icono grande del ítem -->
            <ImageView fx:id="itemImageView"
                       fitWidth="160"
                       fitHeight="160"
                       preserveRatio="true" />

            <!-- Nombre del ítem -->
            <Label fx:id="itemNameLabel"
                   text="Nombre del ítem"
                   styleClass="overlay-title" />

            <!-- Descripción -->
            <Label fx:id="itemDescLabel"
                   text="Descripción del ítem"
                   wrapText="true"
                   maxWidth="360"
                   styleClass="overlay-description" />

            <!-- Hint tipo Isaac -->
            <Label text="Pulsa ESPACIO / ENTER o haz clic para continuar"
                   styleClass="overlay-hint" />
        </VBox>
    </children>
</StackPane>



