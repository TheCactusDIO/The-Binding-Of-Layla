<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
          xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.layla.ui.ItemPickupOverlayController">
    <children>
        <VBox spacing="12" alignment="CENTER">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <!-- Icono grande del ítem -->
            <ImageView fx:id="itemImageView"
                       fitWidth="160"
                       preserveRatio="true" />

            <!-- Nombre del ítem -->
            <Label fx:id="itemNameLabel" text="Item Name"
                   style="-fx-text-fill: #ffd54f;
                          -fx-font-size: 28;
                          -fx-font-weight: bold;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 10, 0.5, 0, 0);" />

            <!-- Descripción -->
            <Label fx:id="itemDescLabel" text="Item description"
                   wrapText="true"
                   maxWidth="360"
                   style="-fx-text-fill: #f5f5f5;
                          -fx-font-size: 16;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 6, 0.5, 0, 0);" />

            <!-- Hint tipo Isaac -->
            <Label text="Press SPACE / ENTER / click to continue"
                   style="-fx-text-fill: #cccccc;
                          -fx-font-size: 12;" />
        </VBox>
    </children>
</StackPane>
