<?xml version="1.0" encoding="UTF-8"?>


<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootBox"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.layla.ui.RankingController"
      spacing="15"
      alignment="TOP_CENTER"
      styleClass="ranking-root">

    <stylesheets>
        <URL value="@css/ranking.css"/>
    </stylesheets>

    <padding>
        <Insets top="20" right="40" bottom="20" left="40"/>
    </padding>

    <!-- Header -->
    <Label text="TOP 20 PARTIDAS"
           styleClass="section-header ranking-title"/>

    <!-- Table -->
    <TableView fx:id="rankingTable"
               VBox.vgrow="ALWAYS"
               styleClass="ranking-table">

        <columns>
            <TableColumn fx:id="rankCol"
                         text="#"
                         prefWidth="50"
                         styleClass="col-center"/>

            <TableColumn fx:id="nameCol"
                         text="JUGADOR"
                         prefWidth="180"/>

            <TableColumn fx:id="scoreCol"
                         text="PUNTUACIÓN"
                         prefWidth="120"
                         styleClass="col-right-bold"/>

            <TableColumn fx:id="floorCol"
                         text="PISO"
                         prefWidth="120"
                         styleClass="col-center"/>

            <TableColumn fx:id="dateCol"
                         text="FECHA"
                         prefWidth="200"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>


